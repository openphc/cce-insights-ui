# CCE Insights UI — Environment Variables
# Copy to .env and adjust values as needed.
# NOTE: these are baked in at build time (Vite inlines VITE_*; the Docker image takes them as
# build args, see Dockerfile). Any of them can also be overridden per deployment at container
# start via the container's env (docker/entrypoint.sh → /srv/env-config.js, see src/env.ts);
# VITE_ROUTER_BASE is the exception — it is build-time only.

# Insights Service base URL
# - Local dev: http://localhost:8084 (Vite proxy handles /v1/insights/)
# - Docker/k8s: leave empty (same origin; the ingress routes /v1 to the gateway)
VITE_API_BASE_URL=

# ---- Authentication (Keycloak / OIDC) ----
# Enable login when the API is behind the gateway (which requires a JWT).
VITE_AUTH_ENABLED=false

# Keycloak realm + PUBLIC client id (same across environments).
# VITE_KEYCLOAK_URL is OPTIONAL: when empty, the app derives it from the browser origin
# (window.location.origin + '/auth'), since the UI and Keycloak share the same domain.
# This keeps the built image environment-agnostic. Set it only to point at a remote/fixed
# Keycloak (e.g. local dev): VITE_KEYCLOAK_URL=https://cceuat.moh.gov.rw/auth
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=cce
VITE_KEYCLOAK_CLIENT_ID=cce-insights-ui

# Optional: static Bearer token fallback for local testing without an interactive login.
VITE_AUTH_TOKEN=

# Auto-refresh polling interval in milliseconds
VITE_POLLING_INTERVAL=60000

# Default date range for dashboard (days)
VITE_DEFAULT_DATE_RANGE_DAYS=90

# Display timezone (IANA name, e.g. Africa/Kigali). API timestamps are shown in this zone and the
# selected date range is converted from it to UTC before being sent (insights-service is UTC only).
# Empty/invalid = UTC.
VITE_TIMEZONE=
