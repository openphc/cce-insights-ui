# CCE Insights UI — Environment Variables
# Copy to .env and adjust values as needed

# Insights Service base URL
# - Local dev: http://localhost:8084 (Vite proxy handles /v1/insights/)
# - Docker: leave empty (Caddy proxies /v1/insights/ to cce-insights-service)
VITE_API_BASE_URL=

# ---- Authentication (Keycloak / OIDC) ----
# Enable login when the API is behind the gateway (which requires a JWT).
VITE_AUTH_ENABLED=false

# Keycloak server, realm and PUBLIC client id. In Docker these are read at container start
# (docker/entrypoint.sh → /srv/env-config.js), so one image serves every environment.
# When VITE_KEYCLOAK_URL is empty the app assumes Keycloak is on the UI's own domain
# (window.location.origin + '/auth').
VITE_KEYCLOAK_URL=https://keycloak.cce.mdtlabs.org/auth
VITE_KEYCLOAK_REALM=cce
VITE_KEYCLOAK_CLIENT_ID=cce-insights-ui

# Optional: static Bearer token fallback for local testing without an interactive login.
VITE_AUTH_TOKEN=

# Auto-refresh polling interval in milliseconds
VITE_POLLING_INTERVAL=60000

# Default date range for dashboard (days)
VITE_DEFAULT_DATE_RANGE_DAYS=90

# Display timezone (IANA name, e.g. Africa/Kigali). API timestamps are shown in this zone and the
# selected date range is converted from it to UTC before being sent (insights-service is UTC only).
# Empty/invalid = UTC. In Docker it is read at container start (docker/entrypoint.sh).
VITE_TIMEZONE=
