:3001 {
	# Encode responses with gzip/zstd
	encode zstd gzip

	# Proxy API calls through gateway-service for JWT validation.
	handle /v1/insights/* {
		reverse_proxy gateway-service:8090
	}

	# Serve the built React SPA with SPA fallback
	handle {
		root * /srv

		# Cache static assets aggressively (hashed filenames)
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Runtime config is regenerated at every container start — never cache it.
		@envconfig path /env-config.js
		header @envconfig Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
